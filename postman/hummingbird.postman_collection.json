{
  "info": {
    "name": "Hummingbird API",
    "description": "Local requests for the Angular/Express rewrite: accounts, public article reads and authenticated publishing. Seed categories first and run in order with the cookie jar enabled. Registration and publishing write to the configured rewrite database; the collection does not remove created accounts or articles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "registrationUsername",
      "value": "Postman Author",
      "type": "string"
    },
    {
      "key": "registrationPassword",
      "value": "postman test password only",
      "type": "string"
    },
    {
      "key": "registrationEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "articleSlug",
      "value": "",
      "type": "string"
    },
    {
      "key": "registeredUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "articleCategoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "articleTagIds",
      "value": "[]",
      "type": "string"
    },
    {
      "key": "newArticleSlug",
      "value": "",
      "type": "string"
    },
    {
      "key": "articleVersion",
      "value": "",
      "type": "string"
    },
    {
      "key": "initialArticleVersion",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "description": "Checks API availability only, without database access."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API is healthy', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.eql({ status: 'ok' });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{registrationUsername}}\",\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"{{registrationPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register",
        "description": "Creates a real test account with a new generated address on every run. Does not log in."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('registrationEmail', `postman-${id}@example.test`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Account created with public fields only', function () {",
              "  pm.response.to.have.status(201);",
              "  const user = pm.response.json().user;",
              "  pm.expect(Object.keys(user).sort()).to.eql(['email', 'id', 'username']);",
              "  pm.expect(user.id).to.be.a('number');",
              "  pm.expect(user.email).to.eql(pm.collectionVariables.get('registrationEmail'));",
              "  pm.expect(user.username).to.eql(pm.variables.get('registrationUsername'));",
              "});",
              "if (pm.response.code === 201) pm.collectionVariables.set('registeredUserId', pm.response.json().user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{registrationUsername}}\",\n  \"email\": \"{{duplicateEmail}}\",\n  \"password\": \"{{registrationPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register",
        "description": "Run Register account first. The same address, with uppercase letters and surrounding spaces, must return 409 without changing the account."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = pm.collectionVariables.get('registrationEmail');",
              "if (!email) throw new Error('Run Register account first.');",
              "pm.variables.set('duplicateEmail', ` ${email.toUpperCase()} `);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate address rejected', function () {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json()).to.eql({",
              "    error: { message: 'An account with this email already exists.' }",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Hummingbird-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"{{registrationPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Signed in with an HTTP-only session cookie', function () {",
              "  pm.response.to.have.status(200);",
              "  const user = pm.response.json().user;",
              "  pm.expect(Object.keys(user).sort()).to.eql(['email', 'id', 'username']);",
              "  pm.expect(user.email).to.eql(pm.collectionVariables.get('registrationEmail'));",
              "  pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Session identifies the registered account', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('registrationEmail'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Hummingbird-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"incorrect test password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Incorrect password returns a generic error', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json()).to.eql({ error: { message: 'Invalid email or password.' } });",
              "  pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Session still active",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Failed login preserved the existing session', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('registrationEmail'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Category options",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories",
        "description": "Public read. Saves the first category ID for publishing; run npm run db:seed if the catalog is empty."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Category options contain only public catalog fields', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().categories).to.be.an('array');",
              "  pm.response.json().categories.forEach(function (item) { pm.expect(Object.keys(item).sort()).to.eql(['id', 'name', 'slug']); });",
              "});",
              "const first = pm.response.json().categories[0];",
              "pm.collectionVariables.set('articleCategoryId', first ? first.id : '');"
            ]
          }
        }
      ]
    },
    {
      "name": "Tag options",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tags",
        "description": "Public read. Selects at most two existing tags; an empty tag catalog is valid."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Tag options contain only public catalog fields', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().tags).to.be.an('array');",
              "  pm.response.json().tags.forEach(function (item) { pm.expect(Object.keys(item).sort()).to.eql(['id', 'name', 'slug']); });",
              "});",
              "pm.collectionVariables.set('articleTagIds', JSON.stringify(pm.response.json().tags.slice(0, 2).map(function (tag) { return tag.id; })));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create article",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Hummingbird-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles",
        "description": "Writes a real article and tag links owned by the signed-in account. Run Login and catalog options first. Generates a new slug on each run.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"slug\": \"{{newArticleSlug}}\",\n  \"title\": \"Publishing from Postman\",\n  \"description\": \"An article created through the authenticated API.\",\n  \"body\": \"First paragraph.\\n\\nSecond paragraph.\",\n  \"categoryId\": {{articleCategoryId}},\n  \"tagIds\": {{articleTagIds}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!Number(pm.collectionVariables.get('articleCategoryId'))) throw new Error('Seed categories and run Category options first.');",
              "pm.collectionVariables.set('newArticleSlug', 'postman-' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Published article belongs to the signed-in account', function () {",
              "  pm.response.to.have.status(201);",
              "  const article = pm.response.json().article;",
              "  pm.expect(article.slug).to.eql(pm.collectionVariables.get('newArticleSlug'));",
              "  pm.expect(article.author.id).to.eql(Number(pm.collectionVariables.get('registeredUserId')));",
              "  pm.expect(Object.keys(article.author).sort()).to.eql(['id', 'username']);",
              "  pm.expect(article.category.id).to.eql(Number(pm.collectionVariables.get('articleCategoryId')));",
              "  pm.expect(article.tags.map(function (tag) { return tag.id; }).sort()).to.eql(JSON.parse(pm.collectionVariables.get('articleTagIds')).sort());",
              "  pm.expect(article.version).to.eql('1');",
              "  pm.expect(article.commentCount).to.eql(0);",
              "  pm.expect(article.imageFilename).to.eql(null);",
              "  pm.expect(pm.response.headers.get('Location')).to.eql('/api/articles/' + article.slug);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate article slug",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Hummingbird-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles",
        "description": "Run Create article first. Must reject the same slug without changing the stored article.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"slug\": \"{{newArticleSlug}}\",\n  \"title\": \"Publishing from Postman\",\n  \"description\": \"An article created through the authenticated API.\",\n  \"body\": \"This must not replace the existing article.\",\n  \"categoryId\": {{articleCategoryId}},\n  \"tagIds\": {{articleTagIds}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('newArticleSlug')) throw new Error('Run Create article first.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate slug rejected without replacing the article', function () {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().error.fields.slug).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Created article detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/articles/{{newArticleSlug}}",
        "description": "Public read of the newly published article. Confirms the duplicate request did not alter it."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('newArticleSlug')) throw new Error('Run Create article first.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Published article is readable and unchanged', function () {",
              "  pm.response.to.have.status(200);",
              "  const article = pm.response.json().article;",
              "  pm.expect(article.slug).to.eql(pm.collectionVariables.get('newArticleSlug'));",
              "  pm.expect(article.body).to.eql('First paragraph.\\n\\nSecond paragraph.');",
              "  pm.expect(article.version).to.eql('1');",
              "  pm.collectionVariables.set('articleVersion', article.version);",
              "  pm.collectionVariables.set('initialArticleVersion', article.version);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update own article",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Hummingbird-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{newArticleSlug}}",
        "description": "Updates content and removes tag links without changing the URL. Run Created article detail first.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated from Postman\",\n  \"description\": \"An edited article.\",\n  \"body\": \"Updated paragraph.\\n\\nAnother paragraph.\",\n  \"categoryId\": {{articleCategoryId}},\n  \"tagIds\": [],\n  \"version\": \"{{articleVersion}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('newArticleSlug') || !pm.collectionVariables.get('articleVersion')) throw new Error('Run Created article detail first.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Author can save with the current version', function () {",
              "  pm.response.to.have.status(200);",
              "  const article = pm.response.json().article;",
              "  pm.expect(article.slug).to.eql(pm.collectionVariables.get('newArticleSlug'));",
              "  pm.expect(article.author.id).to.eql(Number(pm.collectionVariables.get('registeredUserId')));",
              "  pm.expect(article.title).to.eql('Updated from Postman');",
              "  pm.expect(article.tags).to.eql([]);",
              "  pm.expect(article.version).to.match(/^[1-9][0-9]*$/);",
              "  pm.expect(article.version).not.to.eql(pm.collectionVariables.get('articleVersion'));",
              "  pm.collectionVariables.set('articleVersion', article.version);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Stale article edit",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Hummingbird-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{newArticleSlug}}",
        "description": "Reuses the original version; must not overwrite the saved edit.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated from Postman\",\n  \"description\": \"An edited article.\",\n  \"body\": \"Updated paragraph.\\n\\nAnother paragraph.\",\n  \"categoryId\": {{articleCategoryId}},\n  \"tagIds\": [],\n  \"version\": \"{{initialArticleVersion}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('newArticleSlug') || !pm.collectionVariables.get('articleVersion')) throw new Error('Run Created article detail first.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Stale version rejected', function () {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().error.fields.version).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Updated article detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/articles/{{newArticleSlug}}",
        "description": "Confirms the stored edit was not overwritten by the stale request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Edited content and version persisted', function () {",
              "  pm.response.to.have.status(200);",
              "  const article = pm.response.json().article;",
              "  pm.expect(article.body).to.eql('Updated paragraph.\\n\\nAnother paragraph.');",
              "  pm.expect(article.tags).to.eql([]);",
              "  pm.expect(article.version).to.eql(pm.collectionVariables.get('articleVersion'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Hummingbird-Request",
            "value": "1"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logged out and cookie cleared', function () {",
              "  pm.response.to.have.status(204);",
              "  pm.expect(pm.response.text()).to.eql('');",
              "  pm.expect(pm.response.headers.get('Set-Cookie')).to.include('Expires=Thu, 01 Jan 1970');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Session revoked",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logged-out request cannot authenticate', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json()).to.eql({ error: { message: 'Please sign in.' } });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Publishing after logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Hummingbird-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles",
        "description": "Run Logout first. A revoked session must not be able to publish, even if the input is valid.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"slug\": \"{{newArticleSlug}}\",\n  \"title\": \"Publishing from Postman\",\n  \"description\": \"An article created through the authenticated API.\",\n  \"body\": \"First paragraph.\\n\\nSecond paragraph.\",\n  \"categoryId\": {{articleCategoryId}},\n  \"tagIds\": {{articleTagIds}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Publishing requires a current session', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json()).to.eql({ error: { message: 'Please sign in.' } });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Editing after logout",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Hummingbird-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{newArticleSlug}}",
        "description": "Revoked sessions cannot edit an article.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated from Postman\",\n  \"description\": \"An edited article.\",\n  \"body\": \"Updated paragraph.\\n\\nAnother paragraph.\",\n  \"categoryId\": {{articleCategoryId}},\n  \"tagIds\": [],\n  \"version\": \"{{articleVersion}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('newArticleSlug') || !pm.collectionVariables.get('articleVersion')) throw new Error('Run Created article detail first.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Editing requires an active session', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List articles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/articles?page=1&pageSize=12",
        "description": "Public, read-only article summaries. An empty database returns an empty list. Saves the first available slug for Article detail; seed demo data if needed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Public article summaries and pagination', function () {",
              "  pm.response.to.have.status(200);",
              "  const result = pm.response.json();",
              "  pm.expect(result.articles).to.be.an('array');",
              "  pm.expect(result.articles.length).to.be.at.most(12);",
              "  pm.expect(result.pagination.page).to.eql(1);",
              "  pm.expect(result.pagination.pageSize).to.eql(12);",
              "  pm.expect(result.pagination.total).to.be.at.least(0);",
              "  pm.expect(result.pagination.totalPages).to.eql(Math.ceil(result.pagination.total / 12));",
              "  result.articles.forEach(function (article) {",
              "    pm.expect(Object.keys(article.author).sort()).to.eql(['id', 'username']);",
              "    pm.expect(article.tags).to.be.an('array');",
              "    pm.expect(article.commentCount).to.be.at.least(0);",
              "    pm.expect(article).not.to.have.property('body');",
              "    pm.expect(article).not.to.have.property('version');",
              "  });",
              "});",
              "const first = pm.response.json().articles[0];",
              "if (first) pm.collectionVariables.set('articleSlug', first.slug);"
            ]
          }
        }
      ]
    },
    {
      "name": "Article detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/articles/{{articleSlug}}",
        "description": "Public, read-only article detail. Run List articles after seeding demo data, or set articleSlug to a valid existing slug."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('articleSlug')) throw new Error('Seed demo data and run List articles, or set articleSlug.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Public article detail with exact version', function () {",
              "  pm.response.to.have.status(200);",
              "  const article = pm.response.json().article;",
              "  pm.expect(article.slug).to.eql(pm.collectionVariables.get('articleSlug'));",
              "  pm.expect(article.body).to.be.a('string');",
              "  pm.expect(article.version).to.match(/^[1-9][0-9]*$/);",
              "  pm.expect(Object.keys(article.author).sort()).to.eql(['id', 'username']);",
              "  pm.expect(article.tags).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid article page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/articles?page=0",
        "description": "Invalid pagination must return 400 without querying or changing articles."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid pagination rejected', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.message).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    }
  ]
