{
  "info": {
    "name": "Hummingbird API",
    "description": "Local requests for the Angular/Express rewrite. No database connection is implemented yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "description": "Checks API availability only, without database access."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API is healthy', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.eql({ status: 'ok' });",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
