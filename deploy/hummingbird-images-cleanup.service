[Unit]
Description=Remove detached Hummingbird cover images
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=hummingbird
Group=hummingbird
WorkingDirectory=/srv/hummingbird/current/server
EnvironmentFile=/etc/hummingbird/hummingbird.env
ExecStart=/opt/hummingbird/node/bin/node /srv/hummingbird/current/server/dist/scripts/cleanup-images.js
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
