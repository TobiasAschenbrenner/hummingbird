PORT=3000
NODE_ENV=development
# Development defaults to loopback; production defaults to 0.0.0.0.
# HOST=127.0.0.1
# Trust only the reverse proxy used by your host (0 = direct connections).
TRUST_PROXY=0
DATABASE_URL=postgresql://hummingbird_rewrite:replace-me@localhost:5432/hummingbird_rewrite
SHADOW_DATABASE_URL=postgresql://hummingbird_rewrite:replace-me@localhost:5432/hummingbird_rewrite_shadow
TEST_DATABASE_URL=postgresql://hummingbird_rewrite:replace-me@localhost:5432/hummingbird_rewrite_test

# Optional: all three blank disables cover uploads. Real values belong only in server/.env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
